 },
 "review": {
  "status": "draft",
  "flags": [
   "התקופה (אמוראים) נקבעה מכך שנזכר יחד עם רבי אלעזר; התולדות אינו אומר זאת במפורש.",
   "לפי התולדות אין בדף אלא שהיה מטייל עם רבי אלעזר; יש לשקול אם הוא חכם או רק אדם הנזכר בסיפור.",
   "התולדות כותב שיש לתקן את הנוסח בכלאים כפי שהוא מובא בכתובות."
  ],

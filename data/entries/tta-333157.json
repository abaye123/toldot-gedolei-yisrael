 },
 "review": {
  "status": "draft",
  "flags": [
   "התקופה (אמוראים) הוסקה מכך שנזכר לפני רבי יונה; התולדות אינו אומר 'אמורא' במפורש.",
   "לפירוש הקרבן העדה 'כיפ'' אינו חלק מהשם אלא מדברי רבי אבא ('כוף ירך'), ולפי זה אין כאן חכם בשם זה - כדאי לבדוק אם להשאיר את הכרטיס."
  ],
  "written": "2026-10-22"

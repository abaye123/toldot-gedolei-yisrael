 },
 "review": {
  "status": "draft",
  "flags": [
   "התקופה (אמוראים) הוסקה ממאמרו בגמרא. בספר יוחסין כתב שהיה בזמן שמואל, והתולדות דוחה ראיה זו; לא נכתב דור.",
   "טקסט הדף בתולדות נקטע באמצע (סוף ההערה על היוחסין חסר).",
   "בראש הדף מובא פסוק מדברי הימים ('ובני ששן אחלי') לעניין השם בלבד; לא נכתב."
  ],
